{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Почта",
  "version": "0.1.0",
  "identifier": "com.morfius.mail",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Почта",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 700,
        "backgroundColor": "#10121b"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https: http:; connect-src ipc: http://ipc.localhost; frame-src 'self' about:; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Вся ваша почта. В одном месте.",
    "category": "Productivity",
    "windows": {
      "nsis": {
        "displayLanguageSelector": true,
        "languages": ["Russian", "English"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
